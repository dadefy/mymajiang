# 复制为 .env 后填写真实值。.env 本身已被 .gitignore 排除，不要提交。
PORT=3000
HOST=127.0.0.1
WS_PORT=3001

# 用于签发用户令牌与管理员令牌，至少 32 个字符。换掉它会使所有已签发的令牌失效。
JWT_SECRET=replace-with-at-least-32-random-characters

# 留空则使用内存模式（重启丢数据）。生产环境必须配置，否则拒绝启动。
DATABASE_URL=postgresql://mianyang:replace-password@127.0.0.1:5432/mianyang_mahjong
DATABASE_SSL=false

# 第一个管理员的引导。**只在账号不存在时创建**，所以密码改过之后把它删掉或保持不变都不会被覆盖。
# 密码至少 12 个字符，明文不落库（存的是 scrypt 哈希）。
# 生产环境的启动检查要求至少存在一个管理员，否则拒绝启动。
# 后续改密码走 POST /v1/admin/password，不再依赖这两个变量。
ADMIN_ID=local-developer
ADMIN_PASSWORD=replace-with-a-long-random-password

# 对象存储（图片与语音）。留空则上传接口返回 501，群聊仍可用，只是发不了图片/语音。
# 本地驱动把文件落到 STORAGE_LOCAL_DIR，并用自签名 URL 模拟云端预签名直传，
# 所以客户端流程与云端完全一致 —— 开发与自测用它，不需要云账号。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/blobs
# 签名用的密钥，至少 32 字符。留空则复用 JWT_SECRET。
STORAGE_SIGNING_SECRET=
# 服务端对外可达的地址，签出来的直传/读取 URL 指向它。留空则按 HOST/PORT 推断。
PUBLIC_BASE_URL=
# 接入腾讯云 COS 之后要填的四项（驱动换成 cos）：
# STORAGE_DRIVER=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-chengdu
