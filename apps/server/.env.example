# 复制为 .env 后填写真实值。.env 本身已被 .gitignore 排除，不要提交。
# 入口（main.ts / migrate.ts）会用 Node 内建的 process.loadEnvFile 读取本文件，无需 dotenv。
# 公网部署的完整清单见 docs/DEPLOYMENT.md。
PORT=3000
HOST=0.0.0.0
# 实时通道默认与 HTTP 共用同一个端口，这是公网部署的推荐配置：
# 隧道与反向代理通常只给一个入口，而且 HTTPS 页面下浏览器会拦截 ws://，只能用 wss://。
# 只有确实需要单独端口时才解开下面这行。
# WS_PORT=3001

# 设 production 会强制要求 DATABASE_URL，并要求至少存在一个管理员。
# 只是想快速起一个测试环境时**不要设**（内存模式即可）。
# NODE_ENV=production

# 反代后面的真实客户端地址。限流按 request.ip 计数，而反代后面取到的是代理的地址 ——
# 不设就会「全站共用一个额度」，一个人的操作把所有人的登录额度吃光。
#   loopback      Nginx 与它同机（最常见）
#   1 / true      信任所有代理（仅当服务端口只对代理开放时）
#   1.2.3.4/32    精确列出可信网段
# 直连部署（没有反代）时**绝对不能开**：那会让客户端伪造 X-Forwarded-For 绕过限流。
# TRUST_PROXY=loopback

# 用于签发用户令牌与管理员令牌，至少 32 个字符。换掉它会使所有已签发的令牌失效。
JWT_SECRET=replace-with-at-least-32-random-characters

# 留空则使用内存模式（重启丢数据）。生产环境必须配置，否则拒绝启动。
DATABASE_URL=postgresql://mianyang:replace-password@127.0.0.1:5432/mianyang_mahjong
DATABASE_SSL=false

# 第一个管理员的引导。**只在账号不存在时创建**，所以密码改过之后把它删掉或保持不变都不会被覆盖。
# 密码至少 12 个字符，明文不落库（存的是 scrypt 哈希）。
# 生产环境的启动检查要求至少存在一个管理员，否则拒绝启动。
# 后续改密码走 POST /v1/admin/password，不再依赖这两个变量。
ADMIN_ID=local-developer
ADMIN_PASSWORD=replace-with-a-long-random-password

# /debug（浏览器调试客户端）与 /app（LayaAir Web 版）。
# 内测期间**必须保持开启** —— APK 还没构建出来，/debug 是目前唯一可用的界面。
# DEBUG_CLIENT=false

# 只影响启动时打印的那行提示地址，方便复制，不影响实际监听。
# PUBLIC_HOST=牌桌.example.com
# 只有实时通道位于另一个入口时才需要（否则留空，由前端按 location.origin 推导）。
# PUBLIC_WEBSOCKET_URL=wss://牌桌.example.com

# 对象存储（图片与语音）。留空则上传接口返回 501，群聊仍可用，只是发不了图片/语音。
# 本地驱动把文件落到 STORAGE_LOCAL_DIR，并用自签名 URL 模拟云端预签名直传，
# 所以客户端流程与云端完全一致 —— 开发与自测用它，不需要云账号。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/blobs
# 签名用的密钥，至少 32 字符。留空则复用 JWT_SECRET。
STORAGE_SIGNING_SECRET=
# 服务端对外可达的地址，签出来的直传/读取 URL 指向它。留空则按 HOST/PORT 推断。
PUBLIC_BASE_URL=
# 接入腾讯云 COS 之后要填的四项（驱动换成 cos）：
# STORAGE_DRIVER=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=ap-chengdu
