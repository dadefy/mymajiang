# 复制为 .env 后填写真实值。.env 本身已被 .gitignore 排除，不要提交。
PORT=3000
HOST=127.0.0.1
WS_PORT=3001

# 用于签发用户令牌与管理员令牌，至少 32 个字符。换掉它会使所有已签发的令牌失效。
JWT_SECRET=replace-with-at-least-32-random-characters

# 留空则使用内存模式（重启丢数据）。生产环境必须配置，否则拒绝启动。
DATABASE_URL=postgresql://mianyang:replace-password@127.0.0.1:5432/mianyang_mahjong
DATABASE_SSL=false
DEV_ADMIN_ID=local-developer
