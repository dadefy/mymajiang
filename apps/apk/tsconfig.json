{
  "compilerOptions": {
    "module": "es6",
    "target": "es6",
    "strict": true,
    "strictNullChecks": false,
    "noEmitHelpers": true,
    "sourceMap": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "types": [],
    "paths": {
      "~/packages/*": [
        "./library/packages/*"
      ]
    }
  },
  "include": [
    "./assets",
    "./src",
    "./engine",
    "../../packages/client-placeholder"
  ]
}
